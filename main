<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAuth, signInAnonymously, signOut, onAuthStateChanged }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { getFirestore, collection, doc, addDoc, updateDoc, deleteDoc, getDoc, onSnapshot, serverTimestamp }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

// ===== 【重要】替换为您自己的 Firebase 配置 =====
// 从 Firebase 控制台 → 项目设置 → 应用 复制以下内容
const firebaseConfig = {
  apiKey: "AIzaSyBzdgp3wdiZE0n5IxlFCdbzXLNOIEWPM0s",
  authDomain: "master-chef-dd31a.firebaseapp.com",
  projectId: "master-chef-dd31a",
  storageBucket: "master-chef-dd31a.firebasestorage.app",
  messagingSenderId: "608014742124",
  appId: "1:608014742124:web:f585215bb93a0894ea9e49",
  measurementId: "G-Q6EGK4PDVH"
};

// 进店口令（改成您想要的）
const GATE_PASSWORD = "bhz0709";

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

// ===== 全局状态 =====
let cid = localStorage.getItem('bsf_cid') || 'c'+Math.random().toString(36).slice(2,8);
let nick = localStorage.getItem('bsf_nick') || '';
let avatar = localStorage.getItem('bsf_avatar') || '';
localStorage.setItem('bsf_cid', cid);

let plans = [];
let shots = [];
let folks = [];
let folkMap = {};

let currentMonth = new Date();
let selectedDate = null;
let uploadQueue = [];

const $ = s => document.querySelector(s);
const ymd = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const ago = ms => {
  if(!ms) return '刚刚';
  const d = Date.now() - ms;
  if(d < 60000) return '刚刚';
  if(d < 3600000) return Math.floor(d/60000)+'分钟前';
  if(d < 86400000) return Math.floor(d/3600000)+'小时前';
  return Math.floor(d/86400000)+'天前';
};

function avColor(s) {
  const colors = ['#D6242C','#F2B705','#1E6F5C','#5E7A8A','#B4568F'];
  let h = 0;
  for(const ch of (s||'?')) h = (h*31 + ch.charCodeAt(0)) >>> 0;
  return colors[h % colors.length];
}

function avatarHTML(id, name) {
  const av = folkMap[id]?.avatar || '';
  if(av) return `<img class="av" src="${av}" alt="">`;
  const nm = (name || '匿名').charAt(0);
  return `<span class="av-txt" style="background:${avColor(nm)}">${nm}</span>`;
}

// ===== 进店 =====
$('#enterBtn').onclick = async () => {
  const pwd = $('#pwd').value.trim();
  if(!pwd) return;
  if(pwd !== GATE_PASSWORD) {
    $('#gateErr').textContent = '口令不对 🙅';
    $('#gateErr').classList.add('on');
    $('#pwd').select();
    return;
  }
  try {
    await signInAnonymously(auth);
  }catch(e) {
    alert('登不上：' + e.message);
  }
};

$('#pwd').addEventListener('keydown', e => {
  if(e.key==='Enter') $('#enterBtn').click();
});

// ===== 认证状态 =====
onAuthStateChanged(auth, async user => {
  if(user) {
    if(!nick) {
      nick = prompt('输入您的昵称') || '匿名';
      localStorage.setItem('bsf_nick', nick);
    }
    $('#gate').classList.add('hidden');
    $('#app').classList.remove('hidden');
    renderMe();
    listenData();
    ping();
    setInterval(ping, 60000);
  }else{
    $('#app').classList.add('hidden');
    $('#gate').classList.remove('hidden');
    $('#pwd').value = '';
  }
});

async function ping() {
  try {
    await updateDoc(doc(db, 'folks', cid), {
      nick, avatar, lastSeen: Date.now()
    });
  }catch(e) {
    // 新建用户
    try {
      await updateDoc(doc(db, 'folks', cid), {
        nick, avatar, lastSeen: Date.now(), joinedAt: Date.now()
      });
    }catch {
      // 首次新建
    }
  }
}

function renderMe() {
  const av = avatarHTML(cid, nick);
  $('#meBox').innerHTML = `${av}<strong style="max-width:100px;overflow:hidden;text-overflow:ellipsis">${nick}</strong>`;
}

// ===== 监听数据 =====
function listenData() {
  onSnapshot(collection(db, 'plans'), snap => {
    plans = snap.docs.map(d => ({id: d.id, ...d.data()}));
    renderPlans();
    renderCalendar();
  });
  
  onSnapshot(collection(db, 'shots'), snap => {
    shots = snap.docs.map(d => ({id: d.id, ...d.data()}));
    renderAlbum();
  });
  
  onSnapshot(collection(db, 'folks'), snap => {
    folks = snap.docs.map(d => ({id: d.id, ...d.data()}));
    folkMap = Object.fromEntries(folks.map(f => [f.id, f]));
    renderFolks();
  });
}

// ===== 日历 =====
function renderCalendar() {
  const y = currentMonth.getFullYear();
  const m = currentMonth.getMonth();
  const first = new Date(y, m, 1).getDay();
  const days = new Date(y, m+1, 0).getDate();
  
  try {
    $('#monthTitle').textContent = new Date(y,m,1).toLocaleDateString('zh-CN',{year:'numeric',month:'long'});
  }catch {
    $('#monthTitle').textContent = `${y}年${m+1}月`;
  }
  
  const html = [];
  for(let i=0; i<first; i++) html.push('<div class="cal-cell blank"></div>');
  
  for(let d=1; d<=days; d++) {
    const ds = `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const dayPlans = plans.filter(p => p.date === ds);
    const today = ds === ymd(new Date());
    
    html.push(`<button class="cal-cell ${dayPlans.length?'has':''} ${today?'today':''}" data-date="${ds}">
      <span class="date">${d}</span>
      ${dayPlans.length ? `<span class="count">${dayPlans.length}场</span>` : ''}
    </button>`);
  }
  
  $('#calendar').innerHTML = html.join('');
  $('#calendar').querySelectorAll('[data-date]').forEach(el => {
    el.onclick = () => openDay(el.dataset.date);
  });
}

function openDay(ds) {
  selectedDate = ds;
  const d = new Date(ds);
  try {
    $('#dayTitle').textContent = d.toLocaleDateString('zh-CN',{weekday:'long',month:'long',day:'numeric'});
  }catch {
    $('#dayTitle').textContent = ds;
  }
  
  const dayPlans = plans.filter(p => p.date === ds).sort((a,b) => (a.when||'').localeCompare(b.when||''));
  if(!dayPlans.length) {
    $('#dayPlans').innerHTML = '<p style="color:var(--ink-soft);text-align:center">这天还没约饭</p>';
  }else {
    $('#dayPlans').innerHTML = dayPlans.map(p => `
      <div class="plan-card">
        <h3>${p.title}</h3>
        <div class="plan-meta">📍 <b>${p.place}</b> · 🕐 ${p.when}</div>
        <div class="plan-joins">
          <span style="font-size:12px;color:var(--ink-soft)">${p.joins?.length||0}人报名</span>
          ${(p.joins||[]).map(j => avatarHTML(j.cid, j.nick)).join('')}
        </div>
      </div>
    `).join('');
  }
  
  $('#dayModal').classList.add('on');
}

// ===== 约饭 =====
function renderPlans() {
  const today = ymd(new Date());
  const sorted = [...plans].sort((a,b) => {
    const ta = (a.when||'').localeCompare(b.when||'');
    const pa = (a.when||'') < today;
    const pb = (b.when||'') < today;
    if(pa !== pb) return pa?1:-1;
    return ta;
  });
  
  $('#planEmpty').classList.toggle('hidden', sorted.length > 0);
  $('#planList').innerHTML = sorted.map(p => {
    const joined = (p.joins||[]).some(j => j.cid === cid);
    const isPast = (p.when||'') < today;
    
    return `<div class="plan-card ${isPast?'plan-past':''}">
      <h3>${p.title} ${isPast?'(已过)':''}</h3>
      <div class="plan-meta">
        📍 <b>${p.place}</b><br>
        🕐 <b>${p.when}</b><br>
        ${p.note?'💬 '+p.note:''}
      </div>
      <div class="plan-joins">
        <span style="font-size:12px;color:var(--ink-soft)">${p.joins?.length||0}人报名</span>
        ${(p.joins||[]).map(j => avatarHTML(j.cid, j.nick)).join('')}
      </div>
      ${!isPast ? `<button class="plan-join-btn ${joined?'joined':''}" data-plan="${p.id}">
        ${joined?'✓ 已报名':'🙋 我要去'}
      </button>` : ''}
    </div>`;
  }).join('');
  
  $('#planList').querySelectorAll('[data-plan]').forEach(btn => {
    btn.onclick = async () => {
      const p = plans.find(x => x.id === btn.dataset.plan);
      if(!p) return;
      const joined = (p.joins||[]).find(j => j.cid === cid);
      const joins = p.joins || [];
      if(joined) {
        const i = joins.findIndex(j => j.cid === cid);
        joins.splice(i, 1);
      }else {
        joins.push({cid, nick, ms: Date.now()});
      }
      try {
        await updateDoc(doc(db, 'plans', p.id), {joins});
      }catch(e) {
        alert('报名失败：' + e.message);
      }
    };
  });
}

$('#planNew').onclick = () => {
  const d = new Date();
  d.setHours(12,0,0,0);
  $('#planTitle').value = '';
  $('#planPlace').value = '';
  $('#planWhen').value = d.toISOString().slice(0,16);
  $('#planNote').value = '';
  $('#planModal').classList.add('on');
};

$('#quickPlanBtn').onclick = () => {
  const d = new Date(selectedDate);
  d.setHours(12,0,0,0);
  $('#planTitle').value = '';
  $('#planPlace').value = '';
  $('#planWhen').value = d.toISOString().slice(0,16);
  $('#planNote').value = '';
  $('#dayModal').classList.remove('on');
  $('#planModal').classList.add('on');
};

$('#planSaveBtn').onclick = async () => {
  const title = $('#planTitle').value.trim();
  const place = $('#planPlace').value.trim();
  const when = $('#planWhen').value;
  if(!title||!place||!when) {
    alert('请填完所有必填项');
    return;
  }
  const date = when.slice(0,10);
  const note = $('#planNote').value.trim();
  
  try {
    await addDoc(collection(db, 'plans'), {
      title, place, when, note, date,
      joins: [{cid, nick, ms: Date.now()}],
      createdBy: cid, createdAt: serverTimestamp()
    });
    $('#planModal').classList.remove('on');
  }catch(e) {
    alert('保存失败：' + e.message);
  }
};

// ===== 相册 =====
function renderAlbum() {
  const sorted = [...shots].sort((a,b) => (b.ms||0) - (a.ms||0));
  
  $('#albumEmpty').classList.toggle('hidden', sorted.length > 0);
  $('#albumList').innerHTML = sorted.map(s => {
    const imgs = s.images || [];
    const gridClass = imgs.length===1?'':imgs.length===2?'grid-2':imgs.length===3?'grid-3':'grid-4';
    
    return `<div class="album-item">
      <div class="album-header">
        ${avatarHTML(s.cid, s.nick)}
        <div class="album-info">
          <div class="album-nick">${s.nick}</div>
          <div class="album-time">${ago(s.ms)}</div>
        </div>
      </div>
      <div class="album-media ${gridClass}">
        ${imgs.slice(0,4).map((url,i) => `
          <img src="${url}" alt="" data-lightbox="${url}" ${i===3&&imgs.length>4?'style="position:relative"':''}>
          ${i===3&&imgs.length>4?`<div style="position:absolute;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700">+${imgs.length-4}</div>`:''}
        `).join('')}
      </div>
      ${s.caption ? `<div class="album-caption">${s.caption}</div>` : ''}
    </div>`;
  }).join('');
  
  $('#albumList').querySelectorAll('[data-lightbox]').forEach(img => {
    img.onclick = () => openLightbox(img.dataset.lightbox);
  });
}

function openLightbox(url) {
  $('#lightboxImg').src = url;
  $('#lightbox').classList.add('on');
}

function closeLightbox() {
  $('#lightbox').classList.remove('on');
}

$('#uploadBtn').onclick = () => {
  uploadQueue = [];
  $('#previewBox').innerHTML = '';
  $('#albumCaption').value = '';
  $('#fileInput').click();
};

$('#fileInput').onchange = async e => {
  const files = [...e.target.files];
  if(!files.length) return;
  
  for(const f of files) {
    try {
      const reader = new FileReader();
      reader.onload = ev => {
        uploadQueue.push(ev.target.result);
        $('#previewBox').innerHTML += `<div class="img-preview" data-img="${uploadQueue.length-1}">
          <img src="${ev.target.result}" alt="">
          <button class="img-del">✕</button>
        </div>`;
        document.querySelectorAll('.img-del').forEach(btn => {
          btn.onclick = e => {
            const idx = +e.target.closest('.img-preview').dataset.img;
            uploadQueue.splice(idx, 1);
            e.target.closest('.img-preview').remove();
          };
        });
      };
      reader.readAsDataURL(f);
    }catch(err) {
      alert(f.name + '：' + err.message);
    }
  }
  
  if(uploadQueue.length > 0) {
    $('#albumModal').classList.add('on');
  }
  e.target.value = '';
};

$('#albumSaveBtn').onclick = async () => {
  if(!uploadQueue.length) return;
  
  const btn = $('#albumSaveBtn');
  btn.disabled = true;
  btn.textContent = '上传中…';
  
  try {
    await addDoc(collection(db, 'shots'), {
      nick, cid, avatar,
      images: uploadQueue,
      caption: $('#albumCaption').value.trim(),
      ms: Date.now(),
      createdAt: serverTimestamp()
    });
    $('#albumModal').classList.remove('on');
    uploadQueue = [];
  }catch(e) {
    alert('上传失败：' + e.message);
  }finally {
    btn.disabled = false;
    btn.textContent = '传上去';
  }
};

// ===== 用户列表 =====
function renderFolks() {
  const now = Date.now();
  const online = folks.filter(f => (now - (f.lastSeen||0)) < 3*60*1000);
  
  $('#folksList').innerHTML = folks.map(f => {
    const isOnline = (now - (f.lastSeen||0)) < 3*60*1000;
    const isMe = f.id === cid;
    
    return `<div class="folk-card">
      ${f.avatar ? `<img class="av" src="${f.avatar}" alt="">` : `<span class="av-txt" style="background:${avColor(f.nick)}">${(f.nick||'?').charAt(0)}</span>`}
      <div class="nick">${f.nick}</div>
      <div class="status">
        <span class="status-dot ${isOnline?'on':'off'}"></span>
        ${isOnline?'在线':ago(f.lastSeen||0)}
        ${isMe?' (你)':''}
      </div>
    </div>`;
  }).join('');
}

// ===== 头像 =====
$('#changeAv').onclick = () => $('#avModal').classList.add('on');

$('#avFile').onchange = async e => {
  const f = e.target.files[0];
  if(!f) return;
  
  const status = $('#avStatus');
  status.textContent = '处理中…';
  
  try {
    const reader = new FileReader();
    reader.onload = async ev => {
      // 简单压缩（生成缩略图）
      const img = new Image();
      img.onload = async () => {
        const canvas = document.createElement('canvas');
        const s = Math.min(100, Math.min(img.width, img.height));
        canvas.width = canvas.height = 100;
        canvas.getContext('2d').drawImage(img, (img.width-s)/2, (img.height-s)/2, s, s, 0, 0, 100, 100);
        avatar = canvas.toDataURL('image/jpeg', 0.8);
        localStorage.setItem('bsf_avatar', avatar);
        await ping();
        renderMe();
        status.textContent = '换好了！';
        setTimeout(() => $('#avModal').classList.remove('on'), 500);
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(f);
  }catch(e) {
    status.textContent = '失败：' + e.message;
  }
};

